# Local dev: run `npx prisma dev` (no Docker needed) and copy the printed
# connection string here. Production/preview: use your Neon/Vercel Postgres URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/template1?sslmode=disable"

# Local only, and only needed for `prisma migrate dev`. `prisma dev` serves the
# app database as template1, which Postgres copies into new databases — so
# Prisma's auto-created shadow database inherits the schema and migrations
# fail. Point this at another database on the shadow port (main port + 1).
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?sslmode=disable"

# Auth.js session encryption secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Microsoft Entra ID (Azure AD) app registration — see README for setup steps.
# Only registered as a sign-in provider when ALL THREE are set.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0/"

# Demo mode is ON automatically whenever the AUTH_MICROSOFT_ENTRA_ID_* values
# above are absent — passwordless sign-in plus fictional seeded prospects, so a
# deployment is usable before SSO is set up. Anyone with the URL can get in.
# Set either to "true"/"false" only to override that default.
ENABLE_DEMO_LOGIN=""
SEED_DEMO_DATA=""
