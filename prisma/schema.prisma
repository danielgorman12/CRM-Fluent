// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Lookups -----------------------------------------------------------

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String
  title    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  dealsOwned         Prospect[]             @relation("DealOwner")
  createdProspects   Prospect[]             @relation("CreatedBy")
  stageChanges       ProspectStageHistory[]
  scorecardsScored   Scorecard[]
  thesesUpdated      AcquisitionThesis[]
  sellerInfoReviewed SellerRelationship[]
  forecastsCreated   ProspectForecast[]
  valuationsUpdated  ValuationAnalysis[]
  activitiesLogged   SourcingActivity[]
  tripsPlanned       Trip[]
  campaigns          Campaign[]
}

model Vertical {
  id   String @id @default(cuid())
  name String @unique

  prospects Prospect[]
}

enum StageCategory {
  ACTIVE
  CLOSED_WON
  CLOSED_LOST
}

model StageDefinition {
  id         String        @id @default(cuid())
  name       String        @unique
  order      Int
  category   StageCategory
  colorHex   String
  isTerminal Boolean       @default(false)

  prospects     Prospect[]
  stageHistory  ProspectStageHistory[]
}

// --- Core ----------------------------------------------------------------

enum GeocodeStatus {
  PENDING
  GEOCODED
  MANUAL
  FAILED
}

model Prospect {
  id          String  @id @default(cuid())
  name        String
  website     String?
  description String?

  verticalId String?
  vertical   Vertical? @relation(fields: [verticalId], references: [id])

  country String?
  region  String?
  city    String?

  latitude      Float?
  longitude     Float?
  geocodeStatus GeocodeStatus @default(PENDING)
  geocodeSource String?
  geocodedAt    DateTime?

  currentARR             Decimal?
  currentEBITDA          Decimal?
  currentEBITDAMargin    Decimal?
  customerRetentionNotes String?
  grossRetentionPct      Decimal?
  netRetentionPct        Decimal?

  currentStageId String
  currentStage   StageDefinition @relation(fields: [currentStageId], references: [id])

  dealOwnerId String
  dealOwner   User   @relation("DealOwner", fields: [dealOwnerId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageHistory       ProspectStageHistory[]
  tripVisits         TripVisit[]
  meetingNotes       MeetingNote[]
  campaignRecipients CampaignRecipient[]
  scorecard          Scorecard?
  thesis             AcquisitionThesis?
  sellerRelationship SellerRelationship?
  forecast           ProspectForecast?
  valuation          ValuationAnalysis?
  activities         SourcingActivity[]

  @@index([currentStageId])
  @@index([verticalId])
  @@index([dealOwnerId])
}

model ProspectStageHistory {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  stageId String
  stage   StageDefinition @relation(fields: [stageId], references: [id])

  enteredAt DateTime  @default(now())
  exitedAt  DateTime?

  changedById String
  changedBy   User    @relation(fields: [changedById], references: [id])
  notes       String?

  @@index([prospectId])
  @@index([stageId])
}

// --- Scorecard (item 3) ---------------------------------------------------

model Scorecard {
  id String @id @default(cuid())

  prospectId String   @unique
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  financialAttractivenessScore Int
  customerRetentionScore      Int
  recurringRevenueQualityScore Int
  strategicFitScore            Int
  verticalAttractivenessScore  Int
  sellerWillingnessScore       Int
  keyRisksScore                Int
  valuationReturnsScore        Int

  financialAttractivenessNotes String?
  customerRetentionNotes       String?
  recurringRevenueQualityNotes String?
  strategicFitNotes            String?
  verticalAttractivenessNotes  String?
  sellerWillingnessNotes       String?
  keyRisksNotes                String?
  valuationReturnsNotes        String?

  overallScore        Decimal
  scoringMethodVersion String @default("v1")

  scoredById String
  scoredBy   User     @relation(fields: [scoredById], references: [id])
  scoredAt   DateTime @updatedAt
}

// --- Acquisition Thesis (item 4) -------------------------------------------

model AcquisitionThesis {
  id String @id @default(cuid())

  prospectId String   @unique
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  whyCompanyAttractive  String?
  whyVerticalAttractive String?
  synergies             String?
  keyRisks              String?
  whyOwnerMightSell      String?
  whyNow                 String?
  recommendedNextAction  String?

  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// --- Seller & Succession intelligence (items 5 + 6, merged) ---------------

enum SuccessionTimeline {
  UNDER_1YR
  ONE_TO_3YR
  THREE_TO_5YR
  FIVE_PLUS_YR
  UNKNOWN
}

enum SuccessorStatus {
  NONE
  FAMILY
  INTERNAL
  UNKNOWN
}

model SellerRelationship {
  id String @id @default(cuid())

  prospectId String   @unique
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  ownerName                  String?
  ownerAge                   Int?
  yearsOwned                 Int?
  expectedSuccessionTimeline SuccessionTimeline?
  successorIdentified        SuccessorStatus?
  ownershipChangeHistory     String?

  sellerStatedObjectives     String?
  sellerPriceExpectationLow  Decimal?
  sellerPriceExpectationHigh Decimal?
  sellerWillingnessNotes     String?
  otherSuccessionSignals     String?

  lastReviewedById String?
  lastReviewedBy   User?     @relation(fields: [lastReviewedById], references: [id])
  lastReviewedAt   DateTime?
}

// --- Forecast (item 7) ------------------------------------------------------

model ProspectForecast {
  id String @id @default(cuid())

  prospectId String   @unique
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  forecastedRevenueGrowthPct  Decimal?
  forecastedARR                Decimal?
  forecastedEBITDA             Decimal?
  forecastedEBITDAMargin       Decimal?
  marginImprovementOpportunity String?
  marginImprovementPts         Decimal?
  keyAssumptions                String?
  horizonYears                   Int?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt
}

// --- Valuation (item 8) — canonical home for forecastedPurchasePrice/ROCE --

model ValuationAnalysis {
  id String @id @default(cuid())

  prospectId String   @unique
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  indicativePriceRangeLow  Decimal?
  indicativePriceRangeHigh Decimal?
  revenueMultipleLow       Decimal?
  revenueMultipleHigh      Decimal?
  ebitdaMultipleLow        Decimal?
  ebitdaMultipleHigh       Decimal?
  forecastedPurchasePrice  Decimal?
  expectedROCE             Decimal?
  valuationNotes           String?

  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// --- Sourcing activity (item 9) --------------------------------------------

enum ActivityType {
  EMAIL
  CALL
  MEETING
  OTHER
}

model SourcingActivity {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  activityType ActivityType
  activityDate DateTime

  contactedById String
  contactedBy   User   @relation(fields: [contactedById], references: [id])

  contactPersonName  String?
  resultedInResponse Boolean @default(false)
  outcomeNotes       String?

  followUpRequired Boolean   @default(false)
  followUpDate     DateTime?
  followUpNotes    String?

  createdAt DateTime @default(now())

  tripVisit         TripVisit?
  meetingNote       MeetingNote?
  campaignRecipient CampaignRecipient?

  @@index([prospectId])
  @@index([activityDate])
}

// --- Meeting notes (Granola) ------------------------------------------------

enum NoteSource {
  GRANOLA
  MANUAL
}

model MeetingNote {
  id String @id @default(cuid())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  source NoteSource @default(GRANOLA)
  // Provider's meeting id. Unique so re-syncing updates rather than duplicates.
  externalId String? @unique

  title       String
  meetingDate DateTime
  attendees   String?
  summary     String
  actionItems String?

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set when this note has also been recorded as outreach activity.
  loggedActivityId String?           @unique
  loggedActivity   SourcingActivity? @relation(fields: [loggedActivityId], references: [id])

  @@index([prospectId])
}

// --- Outreach campaigns ------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SENT
}

model Campaign {
  id String @id @default(cuid())

  name    String
  subject String         @default("")
  body    String         @default("")
  status  CampaignStatus @default(DRAFT)

  // What the recipient list was built from, shown for context on the campaign.
  geographyNote String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  recipients CampaignRecipient[]

  @@index([createdById])
}

model CampaignRecipient {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  // Snapshot of the merged content at send time, so what went out is auditable
  // even after the template is edited.
  renderedSubject String?
  renderedBody    String?
  sentAt          DateTime?

  loggedActivityId String?           @unique
  loggedActivity   SourcingActivity? @relation(fields: [loggedActivityId], references: [id])

  @@unique([campaignId, prospectId])
  @@index([campaignId])
}

// --- Sourcing trips ---------------------------------------------------------

enum DistanceUnit {
  MI
  KM
}

model Trip {
  id String @id @default(cuid())

  name        String
  destination String
  latitude    Float
  longitude   Float
  startDate   DateTime
  endDate     DateTime
  radius      Int
  unit        DistanceUnit
  perDay      Int

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits TripVisit[]

  @@index([createdById])
}

model TripVisit {
  id String @id @default(cuid())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  visitDate DateTime
  sortOrder Int      @default(0)

  // Snapshot of the ranking when the trip was saved, so an itinerary doesn't
  // silently reshuffle as stages and scorecards move on afterwards.
  priority Int
  distance Float

  // Set once this visit has been written into the prospect's activity log,
  // so it can't be logged twice.
  loggedActivityId String?           @unique
  loggedActivity   SourcingActivity? @relation(fields: [loggedActivityId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tripId, prospectId])
  @@index([tripId])
}

// --- Phase 2 forward-compat: generic data lineage (unused in Phase 1) -----

enum SourceType {
  MANUAL
  EXTRACTED
  CALCULATED
}

enum ValidationStatus {
  CONFIRMED
  NEEDS_REVIEW
  MISSING
  CONFLICTING
  MANUALLY_OVERRIDDEN
}

model FieldSource {
  id               String            @id @default(cuid())
  entityType       String
  entityId         String
  fieldName        String
  sourceType       SourceType
  sourceDetail     String?
  reportingPeriod  String?
  currency         String?
  confidence       Float?
  validationStatus ValidationStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId, fieldName])
}
